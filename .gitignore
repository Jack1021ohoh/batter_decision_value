# Data (pulled via data_fetch; large, not versioned).
# The directory itself is tracked via .gitkeep so fetch_season() has somewhere
# to write on a fresh clone; everything in it stays local.
data/*
!data/.gitkeep
*.csv
*.parquet

# Environment
.venv/
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Working roadmap. Deliberately untracked: it is scaffolding, it describes
# paths that were abandoned as the work went on, and a stale plan misleads a
# reader of the finished project. The durable results live in FINDINGS.md.
IMPROVEMENT_PLAN.md
